Options -Indexes
<FilesMatch "\.(sqlite|sqlite3|db|log|md|py)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:tools|tests|\.git|\.github)(?:/|$) - [F,L]
</IfModule>
